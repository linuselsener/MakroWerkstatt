<Window x:Class="MakroWerkstatt.PassphraseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export-Passphrase" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F7FA"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="Passphrase" FontSize="19" FontWeight="SemiBold" Foreground="#14243A" />
        <TextBlock x:Name="ExplanationText" Grid.Row="1" Margin="0,8,0,15" TextWrapping="Wrap" Foreground="#45566C" />
        <TextBlock Grid.Row="2" Text="Passphrase" FontWeight="SemiBold" Margin="0,0,0,5" />
        <PasswordBox x:Name="PrimaryPasswordBox" Grid.Row="3" MinWidth="360" Padding="8,6"
                     AutomationProperties.AutomationId="ExportPassphraseBox" />
        <StackPanel x:Name="ConfirmationPanel" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="Passphrase bestätigen" FontWeight="SemiBold" Margin="0,0,0,5" />
            <PasswordBox x:Name="ConfirmationPasswordBox" Padding="8,6"
                         AutomationProperties.AutomationId="ConfirmPassphraseBox" />
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="5" Foreground="#9B2735" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Abbrechen" IsCancel="True" MinWidth="92" Padding="12,7" Margin="0,0,8,0" />
            <Button Content="Weiter" IsDefault="True" MinWidth="92" Padding="12,7" Click="Continue_Click"
                    AutomationProperties.AutomationId="PassphraseContinueButton" />
        </StackPanel>
    </Grid>
</Window>
